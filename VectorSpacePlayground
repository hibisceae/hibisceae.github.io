<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vector Space Playground</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Arial', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            height: 100vh;
            margin: 0;
            padding: 0;
            overflow: hidden;
        }

        .header {
            display: none;
        }

        .main-container {
            position: relative;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
        }

        .canvas-container {
            position: absolute;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: #fafafa;
            padding: 0;
            margin: 0;
        }

        .controls {
            position: fixed;
            top: 20px;
            right: 20px;
            width: 450px;
            background: rgba(255, 255, 255, 0.98);
            border-radius: 20px;
            padding: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
            max-height: calc(100vh - 40px);
            overflow-y: auto;
            overflow-x: hidden;
            z-index: 1000;
            transform: translateX(100%);
            transition: transform 0.3s ease;
            backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .controls.open {
            transform: translateX(0);
        }

        .controls-toggle {
            position: fixed;
            top: 20px;
            right: 20px;
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            border-radius: 50%;
            color: white;
            font-size: 24px;
            cursor: pointer;
            z-index: 1001;
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.25);
            transition: all 0.3s ease;
            backdrop-filter: blur(15px);
            border: 2px solid rgba(255, 255, 255, 0.3);
        }

        .controls-toggle:hover {
            transform: scale(1.1);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3);
        }

        .controls-toggle.open {
            right: 490px;
        }

        #canvas {
            width: 100vw;
            height: 100vh;
            border: none;
            cursor: grab;
            background: transparent;
            display: block;
        }

        #canvas:active {
            cursor: grabbing;
        }

        .control-section {
            margin-bottom: 25px;
            padding: 20px;
            background: linear-gradient(145deg, #f0f0f0, #ffffff);
            border-radius: 15px;
            border: 1px solid #e0e0e0;
            overflow: hidden;
        }

        .control-section h3 {
            margin-bottom: 15px;
            color: #333;
            font-size: 16px;
            font-weight: 600;
        }

        .matrix-input {
            display: grid;
            gap: 10px;
            margin-bottom: 15px;
        }

        .matrix-2d {
            grid-template-columns: 1fr 1fr;
        }

        .matrix-3d {
            grid-template-columns: 1fr 1fr 1fr;
        }

        .basis-input-group {
            margin-bottom: 15px;
            padding: 15px;
            background: linear-gradient(145deg, #f8f9fa, #ffffff);
            border-radius: 12px;
            border: 2px solid #e9ecef;
            overflow: hidden;
        }

        .basis-input-group label {
            display: block;
            font-weight: 600;
            color: #495057;
            margin-bottom: 8px;
            font-size: 14px;
        }

        .input-row {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .input-row input {
            flex: 1;
            min-width: 60px;
            padding: 10px 12px;
            border: 2px solid #dee2e6;
            border-radius: 8px;
            font-size: 13px;
            text-align: center;
            transition: all 0.3s ease;
            background: white;
        }

        .input-row input:focus {
            border-color: #667eea;
            outline: none;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
            transform: translateY(-1px);
        }

        .vector-input-group {
            padding: 15px;
            background: linear-gradient(145deg, #fff3cd, #ffffff);
            border-radius: 12px;
            border: 2px solid #ffeaa7;
            margin-bottom: 15px;
            overflow: hidden;
        }

        .animation-control {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 15px;
        }

        .speed-slider {
            flex: 1;
            height: 6px;
            border-radius: 3px;
            background: #e9ecef;
            outline: none;
            -webkit-appearance: none;
        }

        .speed-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: #667eea;
            cursor: pointer;
            box-shadow: 0 2px 6px rgba(0,0,0,0.2);
        }

        .matrix-order {
            background: linear-gradient(145deg, #e3f2fd, #f3e5f5);
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 10px;
            font-size: 12px;
            color: #6a1b9a;
            border: 1px solid #e1bee7;
        }

        .btn {
            padding: 12px 20px;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.3s ease;
            margin: 5px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
        }

        .btn-danger {
            background: linear-gradient(135deg, #ff6b6b 0%, #ee5a52 100%);
            color: white;
        }

        .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(255, 107, 107, 0.3);
        }

        .btn-toggle {
            background: linear-gradient(135deg, #4ecdc4 0%, #44a08d 100%);
            color: white;
        }

        .btn-toggle:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(78, 205, 196, 0.3);
        }

        .matrix-list {
            max-height: 200px;
            overflow-y: auto;
        }

        .matrix-item {
            background: #f8f9fa;
            padding: 15px;
            margin: 10px 0;
            border-radius: 10px;
            border: 1px solid #dee2e6;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .matrix-display {
            font-family: 'Courier New', monospace;
            font-size: 12px;
            color: #495057;
        }

        .dimension-toggle {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

        .info-panel {
            background: linear-gradient(145deg, #e3f2fd, #f3e5f5);
            padding: 15px;
            border-radius: 10px;
            margin-top: 20px;
            border: 1px solid #e1bee7;
        }

        .info-panel h4 {
            color: #6a1b9a;
            margin-bottom: 10px;
        }

        .info-panel p {
            font-size: 12px;
            color: #4a148c;
            line-height: 1.4;
        }

        .vector-tooltip {
            position: absolute;
            background: rgba(0, 0, 0, 0.8);
            color: white;
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 12px;
            pointer-events: none;
            z-index: 1002;
            white-space: nowrap;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .vector-tooltip::after {
            content: '';
            position: absolute;
            top: 100%;
            left: 50%;
            transform: translateX(-50%);
            border: 5px solid transparent;
            border-top-color: rgba(0, 0, 0, 0.8);
        }

        /* 반응형 디자인 */
        @media (max-width: 1200px) {
            .controls {
                width: 400px;
            }
        }

        @media (max-width: 1000px) {
            .controls {
                width: 90vw;
                right: 5vw;
                left: 5vw;
            }
            
            .controls-toggle {
                right: 5vw;
            }
            
            .controls-toggle.open {
                right: calc(95vw - 60px);
            }
        }

        @media (max-width: 768px) {
            .controls {
                padding: 15px;
                width: 95vw;
                right: 2.5vw;
                left: 2.5vw;
            }
            
            .controls-toggle {
                right: 2.5vw;
            }
            
            .controls-toggle.open {
                right: calc(97.5vw - 60px);
            }
            
            .control-section {
                padding: 15px;
            }
            
            .input-row {
                flex-direction: column;
                gap: 5px;
            }
            
            .input-row input {
                min-width: auto;
            }
        }
    </style>
</head>
<body>


    <div class="main-container">
        <div class="canvas-container">
            <canvas id="canvas"></canvas>
        </div>

        <button class="controls-toggle" id="controlsToggle" onclick="toggleControls()">
            ⚙️
        </button>

        <div class="controls" id="controls">
            <div class="control-section">
                <h3>애니메이션 속도</h3>
                <div class="animation-control">
                    <span>느림</span>
                    <input type="range" class="speed-slider" id="speedSlider" min="1" max="10" value="5">
                    <span>빠름</span>
                </div>
            </div>

                         <div class="control-section">
                 
                 <h3>기저 벡터 입력</h3>
                <div id="basisInput">
                    <div class="basis-input-group">
                        <label>î (기저벡터 i):</label>
                        <div class="input-row">
                            <input type="number" step="0.1" value="1" id="i_x" placeholder="x">
                            <input type="number" step="0.1" value="0" id="i_y" placeholder="y">
                            <input type="number" step="0.1" value="0" id="i_z" placeholder="z" style="display: none;">
                        </div>
                    </div>
                    <div class="basis-input-group">
                        <label>ĵ (기저벡터 j):</label>
                        <div class="input-row">
                            <input type="number" step="0.1" value="0" id="j_x" placeholder="x">
                            <input type="number" step="0.1" value="1" id="j_y" placeholder="y">
                            <input type="number" step="0.1" value="0" id="j_z" placeholder="z" style="display: none;">
                        </div>
                    </div>
                    <div class="basis-input-group" style="display: none;" id="k_basis">
                        <label>k̂ (기저벡터 k):</label>
                        <div class="input-row">
                            <input type="number" step="0.1" value="0" id="k_x" placeholder="x">
                            <input type="number" step="0.1" value="0" id="k_y" placeholder="y">
                            <input type="number" step="0.1" value="1" id="k_z" placeholder="z">
                        </div>
                    </div>
                </div>
                <button class="btn btn-primary" onclick="addMatrix()">기저 적용</button>
            </div>

            <div class="control-section">
                <h3>벡터 생성</h3>
                <div class="vector-input-group">
                    <label>벡터 좌표 입력:</label>
                    <div class="input-row" style="margin-top: 8px;">
                        <input type="number" step="0.1" value="1" id="vec_x" placeholder="x">
                        <input type="number" step="0.1" value="1" id="vec_y" placeholder="y">
                        <input type="number" step="0.1" value="1" id="vec_z" placeholder="z" style="display: none;">
                    </div>
                    <button class="btn btn-primary" onclick="addVector()" style="margin-top: 10px; width: 100%;">벡터 추가</button>
                </div>
                <div id="vectorList" style="max-height: 150px; overflow-y: auto; margin-top: 15px;">
                    <!-- Vectors will be listed here -->
                </div>
                <button class="btn btn-danger" onclick="clearVectors()">모든 벡터 제거</button>
            </div>

            <div class="control-section">
                <h3>적용된 행렬들</h3>
                <div class="matrix-order" id="matrixOrder">
                    변환 순서: 없음
                </div>
                <div class="matrix-list" id="matrixList">
                    <p>적용된 행렬이 없습니다.</p>
                </div>
                <button class="btn btn-danger" onclick="clearAllMatrices()">모든 행렬 제거</button>
            </div>

            <div class="info-panel">
                <h4>사용법</h4>
                                 <p>• 우클릭 드래그로 화면을 이동할 수 있습니다<br>
                 • 기저 벡터 값을 입력하고 '기저 적용'을 누르세요<br>
                 • 여러 행렬을 순차적으로 적용할 수 있습니다<br>
                 • 빨간 벡터는 x축, 초록 벡터는 y축, 파란 벡터는 z축입니다<br>
                 • 생성된 벡터는 현재 기저에서의 좌표로 표시됩니다<br>
                 • 벡터 위에 마우스를 올리면 상세 정보가 표시됩니다<br>
                 • 벡터를 클릭하고 드래그하여 위치를 변경할 수 있습니다</p>
            </div>
        </div>
    </div>

    <script>
        const canvas = document.getElementById('canvas');
        const ctx = canvas.getContext('2d');
        
        let is3D = false;
        let matrices = [];
        let vectors = [];
        let animationId = null;
        
                 // Camera and interaction
         let camera = { x: 0, y: 0, zoom: 1 };
         let isDragging = false;
         let lastMousePos = { x: 0, y: 0 };
         
         // Vector dragging
         let isDraggingVector = false;
         let draggedVectorIndex = -1;
         let dragStartPos = { x: 0, y: 0 };
         
         // Tooltip
         let tooltip = null;
         let hoveredVectorIndex = -1;
        
        // Animation state
        let animationProgress = 1;
        let isAnimating = false;
        let animationSpeed = 0.025;
        let currentBasis = [[1, 0], [0, 1]]; // Standard basis
        let targetBasis = [[1, 0], [0, 1]];
        
                 function initCanvas() {
             canvas.width = canvas.offsetWidth;
             canvas.height = canvas.offsetHeight;
             
             canvas.addEventListener('contextmenu', (e) => e.preventDefault());
             canvas.addEventListener('mousedown', handleMouseDown);
             canvas.addEventListener('mousemove', handleMouseMove);
             canvas.addEventListener('mouseup', handleMouseUp);
             canvas.addEventListener('wheel', handleWheel);
             
             // Create tooltip element
             tooltip = document.createElement('div');
             tooltip.className = 'vector-tooltip';
             tooltip.style.display = 'none';
             document.body.appendChild(tooltip);
             
             // Speed slider event
             document.getElementById('speedSlider').addEventListener('input', (e) => {
                 const sliderValue = parseFloat(e.target.value);
                 // Use a non-linear scale for more control over slower speeds
                 animationSpeed = Math.pow(sliderValue / 10, 2) * 0.1;
             });
             
             updateBasisInputs();
             draw();
         }
        
        function toggleDimension(dim) {
            is3D = (dim === 3);
            document.getElementById('btn2d').className = is3D ? 'btn btn-toggle' : 'btn btn-primary';
            document.getElementById('btn3d').className = is3D ? 'btn btn-primary' : 'btn btn-toggle';
            
            // Reset matrices and basis
            matrices = [];
            vectors = [];
            currentBasis = is3D ? [[1, 0, 0], [0, 1, 0], [0, 0, 1]] : [[1, 0], [0, 1]];
            targetBasis = [...currentBasis];
            
            updateBasisInputs();
            updateMatrixList();
            updateVectorList();
            draw();
        }
        
        function updateBasisInputs() {
            const kBasis = document.getElementById('k_basis');
            const zInputs = document.querySelectorAll('#i_z, #j_z, #vec_z');
            
            if (is3D) {
                kBasis.style.display = 'block';
                zInputs.forEach(input => input.style.display = 'block');
            } else {
                kBasis.style.display = 'none';
                zInputs.forEach(input => input.style.display = 'none');
            }
        }
        
        function addMatrix() {
            const dim = is3D ? 3 : 2;
            const matrix = [];
            
            // Get basis vectors from inputs
            const i_vec = [
                parseFloat(document.getElementById('i_x').value) || 0,
                parseFloat(document.getElementById('i_y').value) || 0
            ];
            const j_vec = [
                parseFloat(document.getElementById('j_x').value) || 0,
                parseFloat(document.getElementById('j_y').value) || 0
            ];
            
            if (is3D) {
                i_vec.push(parseFloat(document.getElementById('i_z').value) || 0);
                j_vec.push(parseFloat(document.getElementById('j_z').value) || 0);
                
                const k_vec = [
                    parseFloat(document.getElementById('k_x').value) || 0,
                    parseFloat(document.getElementById('k_y').value) || 0,
                    parseFloat(document.getElementById('k_z').value) || 0
                ];
                
                // The transformation matrix has the new basis vectors as its columns.
                matrix.push([i_vec[0], j_vec[0], k_vec[0]]);
                matrix.push([i_vec[1], j_vec[1], k_vec[1]]);
                matrix.push([i_vec[2], j_vec[2], k_vec[2]]);
            } else {
                // The transformation matrix has the new basis vectors as its columns.
                matrix.push([i_vec[0], j_vec[0]]);
                matrix.push([i_vec[1], j_vec[1]]);
            }
            
            matrices.push(matrix);
            updateMatrixList();
            animateToNewBasis();
        }
        
        function addVector() {
            const vec = [
                parseFloat(document.getElementById('vec_x').value) || 0,
                parseFloat(document.getElementById('vec_y').value) || 0
            ];
            
            if (is3D) {
                vec.push(parseFloat(document.getElementById('vec_z').value) || 0);
            }
            
            vectors.push({
                original: [...vec],
                id: Date.now()
            });
            
            updateVectorList();
            draw();
        }
        
        function removeVector(id) {
            vectors = vectors.filter(v => v.id !== id);
            updateVectorList();
            draw();
        }
        
        function clearVectors() {
            vectors = [];
            updateVectorList();
            draw();
        }
        
        function updateVectorList() {
            const vectorList = document.getElementById('vectorList');
            
            if (vectors.length === 0) {
                vectorList.innerHTML = '<p style="color: #666; font-size: 12px;">생성된 벡터가 없습니다.</p>';
                return;
            }
            
            vectorList.innerHTML = '';
            vectors.forEach((vector) => {
                const item = document.createElement('div');
                item.className = 'matrix-item';
                item.style.fontSize = '12px';
                item.style.padding = '10px';
                
                const display = document.createElement('div');
                const originalCoords = getVectorInCurrentBasis(vector.original);
                
                if (is3D) {
                    display.innerHTML = `
                        <div><strong>벡터:</strong> (${vector.original[0].toFixed(1)}, ${vector.original[1].toFixed(1)}, ${vector.original[2].toFixed(1)})</div>
                    `;
                } else {
                    display.innerHTML = `
                        <div><strong>벡터:</strong> (${vector.original[0].toFixed(1)}, ${vector.original[1].toFixed(1)})</div>
                    `;
                }
                
                const removeBtn = document.createElement('button');
                removeBtn.className = 'btn btn-danger';
                removeBtn.style.fontSize = '10px';
                removeBtn.style.padding = '5px 8px';
                removeBtn.textContent = '×';
                removeBtn.onclick = () => removeVector(vector.id);
                
                item.appendChild(display);
                item.appendChild(removeBtn);
                vectorList.appendChild(item);
            });
        }
        
        function getVectorInCurrentBasis(vec) {
            if (matrices.length === 0) return [...vec];
            
            // Calculate the inverse transformation to get coordinates in current basis
            const finalBasis = calculateFinalBasis();
            return solveLinearSystem(finalBasis, vec);
        }
        
        function solveLinearSystem(A, b) {
            // Simple 2D/3D system solver using Gaussian elimination
            const n = A.length;
            const augmented = A.map((row, i) => [...row, b[i]]);
            
            // Forward elimination
            for (let i = 0; i < n; i++) {
                // Find pivot
                let maxRow = i;
                for (let k = i + 1; k < n; k++) {
                    if (Math.abs(augmented[k][i]) > Math.abs(augmented[maxRow][i])) {
                        maxRow = k;
                    }
                }
                [augmented[i], augmented[maxRow]] = [augmented[maxRow], augmented[i]];
                
                // Make all rows below this one 0 in current column
                for (let k = i + 1; k < n; k++) {
                    const factor = augmented[k][i] / augmented[i][i];
                    for (let j = i; j < n + 1; j++) {
                        augmented[k][j] -= factor * augmented[i][j];
                    }
                }
            }
            
            // Back substitution
            const x = new Array(n);
            for (let i = n - 1; i >= 0; i--) {
                x[i] = augmented[i][n];
                for (let j = i + 1; j < n; j++) {
                    x[i] -= augmented[i][j] * x[j];
                }
                x[i] /= augmented[i][i];
            }
            
            return x;
        }
        
        function removeMatrix(index) {
            matrices.splice(index, 1);
            updateMatrixList();
            updateVectorList();
            animateToNewBasis();
        }
        
        function clearAllMatrices() {
            matrices = [];
            updateMatrixList();
            updateVectorList();
            animateToNewBasis();
        }
        
        function updateMatrixList() {
            const matrixList = document.getElementById('matrixList');
            const matrixOrder = document.getElementById('matrixOrder');
            
            if (matrices.length === 0) {
                matrixList.innerHTML = '<p>적용된 행렬이 없습니다.</p>';
                matrixOrder.textContent = '변환 순서: 없음';
                return;
            }
            
                         // Update order display
             const orderText = matrices.map((_, index) => `M${matrices.length - index}`).join(' × ');
             matrixOrder.innerHTML = `변환 순서: ${orderText} × v<br><small>*가장 오른쪽 행렬(M1)부터 적용됩니다</small>`;
            
            matrixList.innerHTML = '';
            for (let i = matrices.length - 1; i >= 0; i--) {
                const matrix = matrices[i];
                const index = i;
                
                const item = document.createElement('div');
                item.className = 'matrix-item';
                
                const display = document.createElement('div');
                display.className = 'matrix-display';
                display.innerHTML = `<strong>M${index + 1}:</strong><br>${matrixToString(matrix)}`;
                
                const removeBtn = document.createElement('button');
                removeBtn.className = 'btn btn-danger';
                removeBtn.textContent = '제거';
                removeBtn.onclick = () => removeMatrix(index);
                
                item.appendChild(display);
                item.appendChild(removeBtn);
                matrixList.appendChild(item);
            }
        }
        
        function matrixToString(matrix) {
            if (matrix.length === 2) {
                return `[${matrix[0][0].toFixed(1)} ${matrix[0][1].toFixed(1)}]<br>[${matrix[1][0].toFixed(1)} ${matrix[1][1].toFixed(1)}]`;
            } else {
                return `[${matrix[0][0].toFixed(1)} ${matrix[0][1].toFixed(1)} ${matrix[0][2].toFixed(1)}]<br>[${matrix[1][0].toFixed(1)} ${matrix[1][1].toFixed(1)} ${matrix[1][2].toFixed(1)}]<br>[${matrix[2][0].toFixed(1)} ${matrix[2][1].toFixed(1)} ${matrix[2][2].toFixed(1)}]`;
            }
        }
        
        function multiplyMatrices(a, b) {
            const result = [];
            for (let i = 0; i < a.length; i++) {
                result[i] = [];
                for (let j = 0; j < b[0].length; j++) {
                    let sum = 0;
                    for (let k = 0; k < b.length; k++) {
                        sum += a[i][k] * b[k][j];
                    }
                    result[i][j] = sum;
                }
            }
            return result;
        }
        
                 function calculateFinalBasis() {
             if (matrices.length === 0) {
                 return is3D ? [[1, 0, 0], [0, 1, 0], [0, 0, 1]] : [[1, 0], [0, 1]];
             }
             
             let result = matrices[matrices.length - 1];
             for (let i = matrices.length - 2; i >= 0; i--) {
                 result = multiplyMatrices(result, matrices[i]);
             }
             
             return result;
         }
        
        function animateToNewBasis() {
            const newBasis = calculateFinalBasis();
            targetBasis = newBasis;
            animationProgress = 0;
            isAnimating = true;
            animate();
        }
        
        function lerp(a, b, t) {
            return a + (b - a) * t;
        }
        
        function easeOutCubic(t) {
            return 1 - Math.pow(1 - t, 3);
        }
        
        function animate() {
            if (!isAnimating) return;
            
            animationProgress += animationSpeed;
            const t = easeOutCubic(Math.min(animationProgress, 1));
            
            for (let i = 0; i < currentBasis.length; i++) {
                for (let j = 0; j < currentBasis[i].length; j++) {
                    const start = i === j ? 1 : 0; // Standard basis
                    if (matrices.length === 0) {
                        currentBasis[i][j] = lerp(currentBasis[i][j], start, t);
                    } else {
                        currentBasis[i][j] = lerp(currentBasis[i][j], targetBasis[i][j], t);
                    }
                }
            }
            
            draw();
            updateVectorList(); // Update vector coordinates during animation
            
            if (animationProgress >= 1) {
                isAnimating = false;
            } else {
                requestAnimationFrame(animate);
            }
        }
        
