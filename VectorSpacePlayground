        function drawGrid() {
            ctx.strokeStyle = '#e0e0e0';
            ctx.lineWidth = 1;
            
            const gridSize = 1;
            const screenBounds = {
                left: screenToWorld(0, 0).x,
                right: screenToWorld(canvas.width, 0).x,
                top: screenToWorld(0, 0).y,
                bottom: screenToWorld(0, canvas.height).y
            };
            
            // Vertical lines
            for (let x = Math.floor(screenBounds.left); x <= Math.ceil(screenBounds.right); x += gridSize) {
                const screenX = worldToScreen(x, 0).x;
                ctx.beginPath();
                ctx.moveTo(screenX, 0);
                ctx.lineTo(screenX, canvas.height);
                ctx.stroke();
            }
            
            // Horizontal lines
            for (let y = Math.floor(screenBounds.bottom); y <= Math.ceil(screenBounds.top); y += gridSize) {
                const screenY = worldToScreen(0, y).y;
                ctx.beginPath();
                ctx.moveTo(0, screenY);
                ctx.lineTo(canvas.width, screenY);
                ctx.stroke();
            }
        }
        
        function draw2D() {
