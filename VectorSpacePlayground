        function screenToWorld(x, y) {
            return {
                x: (x - canvas.width/2 - camera.x) / (50 * camera.zoom),
                y: -(y - canvas.height/2 - camera.y) / (50 * camera.zoom)
            };
        }
        
        function worldToScreen(x, y) {
            return {
                x: x * 50 * camera.zoom + canvas.width/2 + camera.x,
