                end.x - arrowLength * Math.cos(angle - Math.PI/6),
                end.y - arrowLength * Math.sin(angle - Math.PI/6)
            );
            ctx.lineTo(
                end.x - arrowLength * Math.cos(angle + Math.PI/6),
                end.y - arrowLength * Math.sin(angle + Math.PI/6)
            );
            ctx.closePath();
            ctx.fill();
            
            // Draw label
            ctx.font = '18px Arial';
            ctx.fillText(label, end.x + 10, end.y - 10);
        }
        
