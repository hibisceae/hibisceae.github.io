        function drawTransformedGrid2D() {
            if (matrices.length === 0) return;

            ctx.strokeStyle = 'rgba(102, 126, 234, 0.6)';
            ctx.lineWidth = 1;

            const inverseBasis = getInverseMatrix(currentBasis);
            if (!inverseBasis) return;

            // Get screen corners in world coordinates
            const corners = [
                screenToWorld(0, 0),
                screenToWorld(canvas.width, 0),
                screenToWorld(canvas.width, canvas.height),
                screenToWorld(0, canvas.height)
            ];

            // Transform screen corners to original grid space
            const originalCorners = corners.map(c => {
                const vec = [c.x, c.y];
                const transformed = multiplyMatrixVector(inverseBasis, vec);
                return { x: transformed[0], y: transformed[1] };
            });

            // Find bounding box in original grid space
            const minX = Math.min(...originalCorners.map(c => c.x));
            const maxX = Math.max(...originalCorners.map(c => c.x));
            const minY = Math.min(...originalCorners.map(c => c.y));
            const maxY = Math.max(...originalCorners.map(c => c.y));

            const safetyMargin = 1;
            const startX = Math.floor(minX - safetyMargin);
            const endX = Math.ceil(maxX + safetyMargin);
            const startY = Math.floor(minY - safetyMargin);
            const endY = Math.ceil(maxY + safetyMargin);
            
            const maxLines = 200; // Performance guard
            if ((endX - startX) > maxLines || (endY - startY) > maxLines) {
                return; 
            }

            // Draw transformed grid lines
            for (let i = startX; i <= endX; i++) {
                // Vertical lines
                const p1 = transformPoint(i, startY);
                const p2 = transformPoint(i, endY);
                const s1 = worldToScreen(p1.x, p1.y);
                const s2 = worldToScreen(p2.x, p2.y);
                
                ctx.beginPath();
                ctx.moveTo(s1.x, s1.y);
                ctx.lineTo(s2.x, s2.y);
                ctx.stroke();
            }

            for (let i = startY; i <= endY; i++) {
                // Horizontal lines
                const p3 = transformPoint(startX, i);
                const p4 = transformPoint(endX, i);
                const s3 = worldToScreen(p3.x, p3.y);
                const s4 = worldToScreen(p4.x, p4.y);
                
                ctx.beginPath();
                ctx.moveTo(s3.x, s3.y);
                ctx.lineTo(s4.x, s4.y);
                ctx.stroke();
            }
        }
        
        function transformPoint(x, y) {
            return {
                x: x * currentBasis[0][0] + y * currentBasis[0][1],
                y: x * currentBasis[1][0] + y * currentBasis[1][1]
            };
        }
        
        function drawVector(x, y, color, label) {
