         function transformVector(vec) {
             if (matrices.length === 0) return [...vec];
             
             // Apply all transformations in order (first applied first)
             let result = [...vec];
             for (let i = 0; i < matrices.length; i++) {
                 result = multiplyMatrixVector(matrices[i], result);
             }
             return result;
         }
         
         function multiplyMatrixVector(matrix, vector) {
             const result = [];
             for (let i = 0; i < matrix.length; i++) {
                 let sum = 0;
                 for (let j = 0; j < vector.length; j++) {
                     sum += matrix[i][j] * vector[j];
                 }
                 result[i] = sum;
             }
             return result;
         }
         
         function getInverseMatrix(matrix) {
             const n = matrix.length;
             if (n === 2) {
                 const det = matrix[0][0] * matrix[1][1] - matrix[0][1] * matrix[1][0];
                 if (Math.abs(det) < 1e-10) return null;
                 
                 const invDet = 1 / det;
                 return [
                     [matrix[1][1] * invDet, -matrix[0][1] * invDet],
                     [-matrix[1][0] * invDet, matrix[0][0] * invDet]
                 ];
             } else if (n === 3) {
                 // 3x3 matrix inverse using cofactor method
                 const det = matrix[0][0] * (matrix[1][1] * matrix[2][2] - matrix[1][2] * matrix[2][1]) -
                           matrix[0][1] * (matrix[1][0] * matrix[2][2] - matrix[1][2] * matrix[2][0]) +
                           matrix[0][2] * (matrix[1][0] * matrix[2][1] - matrix[1][1] * matrix[2][0]);
                 
                 if (Math.abs(det) < 1e-10) return null;
                 
                 const invDet = 1 / det;
                 const result = [];
                 
                 for (let i = 0; i < 3; i++) {
                     result[i] = [];
                     for (let j = 0; j < 3; j++) {
                         // Calculate cofactor of (j, i) for the adjugate matrix
                         const cofactor = Math.pow(-1, j + i) * (
                             matrix[(j + 1) % 3][(i + 1) % 3] * matrix[(j + 2) % 3][(i + 2) % 3] -
                             matrix[(j + 1) % 3][(i + 2) % 3] * matrix[(j + 2) % 3][(i + 1) % 3]
                         );
                         result[i][j] = cofactor * invDet;
                     }
                 }
                 
                 return result;
             }
             return null;
         }
         
         function showTooltip(x, y, vector, index) {
             if (hoveredVectorIndex !== index) {
                 hoveredVectorIndex = index;
                 
                 const transformed = matrices.length > 0 ? transformVector(vector.original) : vector.original;
                 const currentCoords = getVectorInCurrentBasis(vector.original);
                 
                 let tooltipText = `벡터 ${index + 1}`;
                 
                 if (is3D) {
                     tooltipText += `<br>원본: (${vector.original[0].toFixed(2)}, ${vector.original[1].toFixed(2)}, ${vector.original[2].toFixed(2)})`;
                     tooltipText += `<br>변환: (${transformed[0].toFixed(2)}, ${transformed[1].toFixed(2)}, ${transformed[2].toFixed(2)})`;
                 } else {
                     tooltipText += `<br>원본: (${vector.original[0].toFixed(2)}, ${vector.original[1].toFixed(2)})`;
                     tooltipText += `<br>변환: (${transformed[0].toFixed(2)}, ${transformed[1].toFixed(2)})`;
                 }
                 
                 tooltip.innerHTML = tooltipText;
                 tooltip.style.display = 'block';
             }
             
             tooltip.style.left = (x + 15) + 'px';
             tooltip.style.top = (y - 15) + 'px';
         }
         
         function hideTooltip() {
             if (hoveredVectorIndex !== -1) {
                 hoveredVectorIndex = -1;
                 tooltip.style.display = 'none';
             }
         }
        
                 // Controls toggle functionality
         function toggleControls() {
             const controls = document.getElementById('controls');
             const toggle = document.getElementById('controlsToggle');
             
             if (controls.classList.contains('open')) {
                 controls.classList.remove('open');
                 toggle.classList.remove('open');
                 toggle.innerHTML = '⚙️';
             } else {
                 controls.classList.add('open');
                 toggle.classList.add('open');
                 toggle.innerHTML = '✕';
             }
         }

         // Initialize
         window.onload = () => {
             initCanvas();
             updateBasisInputs();
         };
         
         window.onresize = () => {
             canvas.width = canvas.offsetWidth;
             canvas.height = canvas.offsetHeight;
             draw();
         };
         
         // Clean up tooltip on page unload
         window.onbeforeunload = () => {
             if (tooltip && tooltip.parentNode) {
                 tooltip.parentNode.removeChild(tooltip);
             }
         };
    </script>
</body>
</html>
